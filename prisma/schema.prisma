generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WorkOrder {
  id                Int      @id @default(autoincrement())
  osNumber          String?  // Número da O.S. informado/gerado por outro sistema
  customerName      String
  device            String
  issue             String
  status            String   @default("AGENDADO")
  scheduledDate     DateTime? // Null quando a O.S. ainda está pendente de agendamento
  estimatedDuration Int?     // Duração estimada do reparo em minutos (ex: 30, 60, 90)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
